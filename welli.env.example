# Copy this file to "welli.env" on the server (same directory as docker-compose.yml)
# and fill in real values. "welli.env" is gitignored — never commit real secrets.
# Docker Compose does NOT auto-load this filename, so every `docker compose`
# command on the server must include `--env-file welli.env` (see docker-compose.yml
# usage notes / deploy workflow).

DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=change-me-must-be-longer-than-32-bytes
JWT_EXPIRATION_MS=3600000

# Comma-separated, no spaces. Add the frontend's deployed domain here once it's live.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://welli-fe-a.vercel.app

# Optional: leave OPENAI_API_KEY empty to fall back to rule-based analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
